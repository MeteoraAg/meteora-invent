{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "validate-env": {
      "cache": false,
      "outputs": []
    },
    "dlmm-create-pool": {
      "cache": false
    },
    "dlmm-seed-liquidity-lfg": {
      "cache": false
    },
    "dlmm-seed-liquidity-single-bin": {
      "cache": false
    },
    "dlmm-set-pool-status": {
      "cache": false
    },
    "dlmm-place-limit-order": {
      "cache": false
    },
    "dlmm-get-limit-orders": {
      "cache": false
    },
    "dlmm-cancel-limit-order": {
      "cache": false
    },
    "damm-v2-create-balanced-pool": {
      "cache": false
    },
    "damm-v2-create-one-sided-pool": {
      "cache": false
    },
    "damm-v2-split-position": {
      "cache": false
    },
    "damm-v2-claim-position-fee": {
      "cache": false
    },
    "damm-v2-add-liquidity": {
      "cache": false
    },
    "damm-v2-remove-liquidity": {
      "cache": false
    },
    "damm-v2-refresh-vesting": {
      "cache": false
    },
    "damm-v2-close-position": {
      "cache": false
    },
    "damm-v1-create-pool": {
      "cache": false
    },
    "damm-v1-lock-liquidity": {
      "cache": false
    },
    "damm-v1-create-stake2earn-farm": {
      "cache": false
    },
    "damm-v1-lock-liquidity-stake2earn": {
      "cache": false
    },
    "dbc-create-config": {
      "cache": false
    },
    "dbc-create-pool": {
      "cache": false
    },
    "dbc-claim-trading-fee": {
      "cache": false
    },
    "dbc-migrate-to-damm-v1": {
      "cache": false
    },
    "dbc-migrate-to-damm-v2": {
      "cache": false
    },
    "dbc-swap": {
      "cache": false
    },
    "dbc-transfer-pool-creator": {
      "cache": false
    },
    "alpha-vault-create": {
      "cache": false
    },
    "presale-vault-create": {
      "cache": false
    }
  }
}
