# Your wallet private key (base58 encoded or JSON array of bytes)
# KEEP THIS SECRET — never commit the actual .env file
PRIVATE_KEY=""

# Dry-run mode controls whether transactions are simulated or actually submitted.
# Default in all config/*.jsonc files is dryRun: true (safe).
# Set dryRun: false in your config ONLY after you understand what will happen.
# DRY_RUN=true  # (controlled per config/*.jsonc file, not here)

# Optional: raises the shared rate limit on Jupiter's quote API used by zap-in-dlmm (get one at https://developers.jup.ag/portal)
# JUPITER_API_KEY=""
# Optional: overrides the Jupiter API base URL used by zap-in-dlmm (defaults to the SDK's own keyless endpoint)
# JUPITER_API_URL=""
